+	// Returns the states of the levels of a lazy LOD: the coarsest level with a mesh and the levels
+	// without a mesh are loaded with the file. Returns null if all levels have to be loaded with it.
+	_getLevelStates( nodeIndices ) {
+
+		const states = [];
+
+		let coarsest = - 1;
+
+		for ( let i = 0, il = nodeIndices.length; i < il; i ++ ) {
+
+			const content = { mesh: false, dynamic: false };
+
+			this._getContent( nodeIndices[ i ], content );
+
+			// Animations and skins refer to nodes, which have to exist when the file is loaded.
+			if ( content.dynamic === true ) return null;
+
+			if ( content.mesh === true ) coarsest = i;
+
+			states.push( content.mesh === true ? LOD_LEVEL_DEFERRED : LOD_LEVEL_LOADED );
+
+		}
+
+		if ( coarsest !== - 1 ) states[ coarsest ] = LOD_LEVEL_LOADED;
+
+		return states.indexOf( LOD_LEVEL_DEFERRED ) !== - 1 ? states : null;
