+const LOD_LEVEL_LOADED = 0;
+const LOD_LEVEL_DEFERRED = 1;
+const LOD_LEVEL_LOADING = 2;
+const LOD_LEVEL_FAILED = 3;
+
+// The number of levels that are loaded at the same time, the nearest ones first. Large levels share
+// the connection, so that more of them at once aren't loaded sooner but delay the nearest ones. Small
+// levels wait for the round trip of their request, so that fewer of them at once take longer.
+const LOD_MAX_LOADING = 3;
+
+const _cameraPosition = new Vector3();
+const _lodPosition = new Vector3();
+
+/**
+ * A LOD with levels that are loaded when they are needed. Until then the nearest
+ * level that is loaded is rendered instead, a coarser one if there is one.
+ *
+ * @private
+ */
+class GLTFLazyLOD extends LOD {
+
+	constructor( extension = null, loadLevel = null, states = [] ) {
+
+		super();
+
+		this._extension = extension;
+		this._loadLevel = loadLevel;
+		this._states = states;
+
+		// The level that has to be loaded, and how far away the camera is.
+		this._wanted = - 1;
+		this._distance = 0;
+
+	}
+
+	copy( source ) {
+
+		super.copy( source );
+
+		this._extension = source._extension;
+		this._loadLevel = source._loadLevel;
+
+		// A level is only added to the LODs that requested it.
+		this._states = source._states.map( function ( state ) {
+
+			return state === LOD_LEVEL_LOADING ? LOD_LEVEL_DEFERRED : state;
+
+		} );
+
+		return this;
+
+	}
+
+	update( camera ) {
+
+		super.update( camera );
+
+		const levels = this.levels;
+		const states = this._states;
+		const wanted = this._currentLevel;
+
+		this._wanted = - 1;
+
+		if ( states[ wanted ] === undefined || states[ wanted ] === LOD_LEVEL_LOADED ) return;
+
+		let current = wanted;
+
+		for ( let i = wanted + 1, il = states.length; i < il && current === wanted; i ++ ) {
+
+			if ( states[ i ] === LOD_LEVEL_LOADED ) current = i;
+
+		}
+
+		for ( let i = wanted - 1; i >= 0 && current === wanted; i -- ) {
+
+			if ( states[ i ] === LOD_LEVEL_LOADED ) current = i;
+
+		}
+
+		levels[ wanted ].object.visible = false;
+		levels[ current ].object.visible = true;
+
+		this._currentLevel = current;
+
+		if ( states[ wanted ] === LOD_LEVEL_DEFERRED ) {
+
+			_cameraPosition.setFromMatrixPosition( camera.matrixWorld );
+			_lodPosition.setFromMatrixPosition( this.matrixWorld );
+
+			this._wanted = wanted;
+			this._distance = _cameraPosition.distanceTo( _lodPosition ) / camera.zoom;
+
+			this._extension._requestLevel( this );
+
+		}
+
+	}
+
+	// Loads a level. The returned promise is never rejected: without the level the LOD renders another one.
+	_load( index ) {
+
+		const scope = this;
+		const states = this._states;
+
+		states[ index ] = LOD_LEVEL_LOADING;
+
+		return new Promise( function ( resolve ) {
+
+			resolve( scope._loadLevel( index ) );
+
+		} ).then( function ( object ) {
+
+			const level = scope.levels[ index ].object;
+
+			// The object already has a parent if this LOD is a clone, or has been cloned.
+			level.add( object.parent === null ? object : clone( object ) );
+			level.updateMatrixWorld( true );
+
+			states[ index ] = LOD_LEVEL_LOADED;
+
+		} ).catch( function ( error ) {
+
+			states[ index ] = LOD_LEVEL_FAILED;
+
+			console.error( 'THREE.GLTFLoader: Couldn\'t load a level of detail.', error );
+
+		} );
+
+	}
+
